import numpy as np

rows = int(input("Enter the number of rows: "))

matrix_1 = []
print("Enter the elements of the first matrix (space-separated):")
for i in range(rows):
    row = list(map(int, input().split()))
    matrix_1.append(row)

matrix_2 = []
print("Enter the elements of the second matrix (space-separated):")
for i in range(rows):
    row = list(map(int, input().split()))
    matrix_2.append(row)

matrix_1 = np.array(matrix_1)
matrix_2 = np.array(matrix_2)

matsum = np.add(matrix_1, matrix_2)
print("Sum of the matrices:")
print(matsum)
