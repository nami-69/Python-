def is_prime(num):
    if num < 2:
        return False
    if num == 2:
        return True
    for i in range(2, num):
        if num % i == 0:
            return False
    return True


with open("file.txt", "r") as file:
    for line in file:
        for word in line.split():
            if is_prime(int(word)):
                print(word)
